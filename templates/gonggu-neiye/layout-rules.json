{
  "schema_version": "0.1",
  "description": "巩固内页模板的实例级排版规则。公用规则继承自项目根目录 shared-rules.json。",
  "page_flow": {
    "skip_empty_tail_spreads": true,
    "repeat_last_practice_spread_when_overflow": true,
    "repeat_last_answer_spread_when_overflow": true,
    "dynamic_page_numbers": true,
    "min_frame_height_pt": {
      "practice_content_flow": 680,
      "answer_content_flow": 680
    }
  },
  "content_detection": {
    "section_title_patterns": [
      "^【.+】$",
      "^练习[一二三四五六七八九十]+$"
    ],
    "section_title_exclude": [
      "【答案】",
      "【解析】"
    ],
    "lesson_title_patterns": [
      "^第[一二三四五六七八九十百]+讲$"
    ],
    "topic_heading_patterns": [
      "^[一二三四五六七八九十]+、\\S+"
    ],
    "reading_prompt_patterns": [
      "^阅读.*(题|完成|回答|问题)"
    ],
    "structural_reading_prompt_exclude_patterns": [
      "^[1-9]\\d*[.．、]",
      "^[A-F][.．]",
      "^（\\d+）"
    ],
    "structural_reading_prompt_keywords": [
      "阅读",
      "选文",
      "短文",
      "文章",
      "完成",
      "回答"
    ],
    "article_title": {
      "max_length": 12,
      "reject_prefixes": [
        "【",
        "（",
        "(",
        "“",
        "《"
      ],
      "reject_patterns": [
        "^[A-F][.．]",
        "^[1-9]\\d*[.．、]"
      ]
    },
    "author_names": [
      "贾平凹"
    ],
    "source_patterns": [
      "^（.*）$"
    ]
  },
  "styles": {
    "main_title": {
      "font": "FZYanSongZhong",
      "size": 23,
      "leading": 34,
      "space_after": 16
    },
    "section_title": {
      "font": "FZYanSongCu",
      "size": 16,
      "leading": 24,
      "space_before": 10
    },
    "article_body": {
      "font": "FZKaiGBK",
      "size": 14,
      "leading": 24,
      "align": "justify-last-left",
      "min_last_line_chars": 2
    },
    "question_stem": {
      "font": "FZYanSongZhun",
      "size": 14,
      "leading": 27,
      "align": "left",
      "space_before": 0,
      "left_indent": 36,
      "wrap_width_factor": 1.0,
      "min_last_line_chars": 2
    },
    "question_content": {
      "left_indent": 36
    },
    "option": {
      "font": "FZKaiGBK",
      "size": 14,
      "leading": 27,
      "align": "left",
      "space_before": 0,
      "left_indent": 36,
      "wrap_width_factor": 1.0,
      "min_last_line_chars": 2
    },
    "answer_body": {
      "font": "FZKaiGBK",
      "size": 14,
      "leading": 23,
      "align": "left"
    },
    "answer_line": {
      "first_space_before": 6
    },
    "table": {
      "leading": 18
    },
    "image": {
      "max_height_pt": 260
    }
  },
  "colors": {
    "practice_red": "#c1020e",
    "practice_bar": "#fce5e4",
    "answer_gray": "#898989",
    "source_text": "#898989",
    "body_text": "cmyk(0,0,0,0.95)"
  },
  "idml": {
    "template_file": "assets/references/巩固内页排版样式.idml",
    "practice_story_id": "u3713",
    "answer_story_id": "u3b07",
    "practice_spread_template": "Spreads/Spread_u3695.xml",
    "answer_spread_template": "Spreads/Spread_u3a1e.xml",
    "practice_master": "u3c8",
    "font_names": {
      "FZYanSongZhong": "方正颜宋简体_中",
      "FZYanSongZhun": "方正颜宋简体_准",
      "FZYanSongCu": "方正颜宋简体_粗",
      "FZKaiGBK": "方正楷体_GBK"
    },
    "paragraph_style_mapping": {
      "main_title": "ParagraphStyle/问题",
      "section": "ParagraphStyle/加粗小标题",
      "topic_heading": "ParagraphStyle/小标题",
      "body": "ParagraphStyle/阅读文章正文",
      "poem_line": "ParagraphStyle/阅读文章正文",
      "question_numbered": "ParagraphStyle/问题",
      "option": "ParagraphStyle/题干",
      "source": "ParagraphStyle/出处",
      "reading_prompt": "ParagraphStyle/例句前",
      "article_title": "ParagraphStyle/问题",
      "author": "ParagraphStyle/出处",
      "answer_body": "ParagraphStyle/答案正文",
      "answer_label": "ParagraphStyle/问题",
      "answer_line": "ParagraphStyle/答案正文",
      "judgement_item": "ParagraphStyle/题干",
      "table": "ParagraphStyle/阅读文章正文"
    },
    "default_paragraph_style": "ParagraphStyle/阅读文章正文",
    "decoration_keys": {
      "title_polygon": "title_polygon",
      "section_bar_textframe": "section_bar_textframe",
      "question_badge_textframe": "question_badge_textframe"
    }
  }
}
